# Local RoadShield configuration. Copy to .env and keep it out of source control.
TESTAPP_ENVIRONMENT=development
TESTAPP_ORIGIN=http://127.0.0.1:8010
TESTAPP_COOKIE_SECURE=false

# Claude is enabled only when this secret is present. Never expose it to the browser.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
TESTAPP_CLAUDE_MODEL=claude-opus-5

# Production must also set a stable secret of at least 32 random bytes and use HTTPS.
# TESTAPP_SECRET=replace-with-a-secret-manager-value
